# Runtime lock file (created in /run, not tracked)
*.lock
.idea/
.worktrees/
__pycache__/
REVIEW.md
# Root-level route files are runtime copies from /etc/surflare/; baseline lives in routes/
cn_ipv4.txt
cn_ipv6.txt

# Local-only files (not for version control)
docs/
CLAUDE.md
*.plan
.claude/

# Forge backend config -- exclude locally deployed .code-forge/ from VCS
.code-forge/

# N100 config snapshots (sensitive: MACs, DHCP leases, keys -- never commit)
# Format: snapshots/n100-YYYYMMDD.tar.gz
# Refresh: ssh root@192.168.100.1 "tar czf - /etc/config/ /etc/surflare/ ..."
snapshots/

# Captured sing-box configs (sensitive: node IPs, transit topology, auth endpoints)
analysis/*.json

# Built binaries from n100/build-singbox.sh (46MB+, rebuild from patch)
n100/surflare-proxy-patched

.planning/
.worktrees
.worktrees/

# N100 sensitive configs (auth tokens, credentials, node IPs -- never commit)
n100/config/auth.dat
n100/config/credentials
n100/config/nodedata.dat
n100/config/server_ips
n100/config/settings.dat
n100/config/wechat.conf
.mcp.json
scratch/
