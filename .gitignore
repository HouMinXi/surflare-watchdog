# Runtime lock file (created in /run, not tracked)
*.lock
.idea/
.worktrees/
__pycache__/
REVIEW.md
# Root-level route files are runtime copies from /etc/surflare/; baseline lives in routes/
cn_ipv4.txt
cn_ipv6.txt

# Local-only files (not for version control)
docs/
CLAUDE.md
*.plan
.claude/

# forge backend config (local only: base_url + api_key_env refs, not for VCS)
.code-forge/

# N100 config snapshots (sensitive: MACs, DHCP leases, keys -- never commit)
# Format: snapshots/n100-YYYYMMDD.tar.gz
# Refresh: ssh root@192.168.100.1 "tar czf - /etc/config/ /etc/surflare/ ..."
snapshots/
