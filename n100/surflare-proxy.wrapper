#!/bin/sh
# surflare-proxy wrapper: patches sing-box config before forwarding to real binary.
# This is the canonical source -- deployed to /usr/bin/surflare-proxy on the N100
# and backed up to /usr/local/sbin/surflare-proxy.canonical for auto-restore.
#
# Patches applied (jq pipeline):
#   1. urltest tolerance/interval tuning
#   2. INJECT_DOMAINS -> proxy_rule_set (domains missing from surflare whitelist)
#   3. catch-all route rule outbound: direct -> VPN (fixes sniff-failure leaks)
#   4. route.final: direct -> VPN (secondary fallback)
#
# md5-gate: auto-restores patched binary if surflare auto-update replaces it.
# The watchdog's _ensure_wrapper() restores THIS wrapper if surflare overwrites it.

ulimit -n 65535 2>/dev/null || true

REAL_BIN="/usr/bin/surflare-proxy.real"
FALLBACK_BIN="/usr/local/lib/surflare-proxy-patched"
EXPECTED_MD5="342ecaa9b0c528a696378a3d0ee67f58"
TOLERANCE=300
INTERVAL="60s"
# Domains missing from surflare's proxy_rule_set that must go through VPN.
INJECT_DOMAINS="claude.com,grokipedia.com,ipinfo.io,myip.wtf"

# md5-gate: detect and rollback surflare auto-update
_md5=$(md5sum "$REAL_BIN" 2>/dev/null | cut -d" " -f1)
if [ "$_md5" != "$EXPECTED_MD5" ] && [ -x "$FALLBACK_BIN" ]; then
	_fb_md5=$(md5sum "$FALLBACK_BIN" 2>/dev/null | cut -d" " -f1)
	if [ "$_fb_md5" = "$EXPECTED_MD5" ]; then
		cp "$REAL_BIN" "/tmp/surflare-proxy-autoupdate-$(date +%Y%m%d_%H%M%S)"
		logger -t surflare-proxy "auto-update rolled back (new binary saved to /tmp)"
		cp "$FALLBACK_BIN" "$REAL_BIN"
	fi
fi

# Detect --config stdin among arguments
_stdin=0
for a in "$@"; do
	case "$a" in
		stdin) _stdin=1 ;;
	esac
done

if [ "$_stdin" -eq 0 ]; then
	exec "$REAL_BIN" "$@"
fi

# Two-stage: save stdin, patch with jq, feed to real binary.
# Check mktemp exit: if /tmp is full or read-only, abort rather than feed
# empty filenames into cat/jq/exec below.
_tmp=$(mktemp) || { logger -t surflare-proxy "ERROR: mktemp failed (_tmp)"; exit 1; }
_patched=$(mktemp) || { logger -t surflare-proxy "ERROR: mktemp failed (_patched)"; rm -f "$_tmp"; exit 1; }
trap 'rm -f "$_tmp" "$_patched"' EXIT

cat > "$_tmp"
# Debug dump only when explicitly enabled (SURFLARE_DEBUG=1).  The sing-box
# config may carry auth tokens; do not persist it to /tmp unconditionally.
[ -n "$SURFLARE_DEBUG" ] && cp "$_tmp" /tmp/singbox-config-dump.json

if jq --argjson T "$TOLERANCE" --arg I "$INTERVAL" --arg D "$INJECT_DOMAINS" '
  .outbounds |= map(if .type == "urltest" then .tolerance = $T | .interval = $I else . end)
  | .route.rule_set |= map(if .tag == "proxy_rule_set" then .rules |= map(
      if .domain_suffix then
        .domain_suffix |= (. + ($D | split(",")) | unique)
      else . end
    ) else . end)
  | ([.outbounds[] | select(.tag|startswith("mh_via_auto_to_"))][0].tag // "direct") as $vpn
  | .route.rules[-1].outbound = $vpn
  | .route.final = $vpn
' < "$_tmp" > "$_patched"; then
	exec < "$_patched"
	rm -f "$_tmp" "$_patched"
	exec "$REAL_BIN" "$@"
else
	# jq failed: config may be malformed or jq missing.  Abort rather than
	# fall back to the unpatched config -- the catch-all route rule would
	# send unmatched traffic direct, leaking past the VPN.  surflare connect
	# fails -> watchdog alerts and retries.
	logger -t surflare-proxy "ERROR: jq config patch failed (malformed config or jq missing?), aborting to prevent traffic leak"
	rm -f "$_tmp" "$_patched"
	exit 1
fi
