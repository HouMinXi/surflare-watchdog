#!/bin/sh
set -u

# procd runs with a predictable PATH; pin it before resolving helpers.
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

# Test seams are honored only for the source-tree copy, never for the installed
# /usr/bin/zoro-exit. Production tools stay absolute.
if [ "${ZORO_TEST_MODE:-0}" = 1 ] &&
	[ "$(basename -- "$(dirname -- "$0")")" = router ] &&
	[ -f "$(dirname -- "$0")/../tests/test_zoro_exit_check.sh" ]; then
	NFT=${ZORO_NFT:-nft}
	IP=${ZORO_IP:-ip}
	SS=${ZORO_SS:-ss}
	CURL=${ZORO_CURL:-curl}
	LOGGER=${ZORO_LOGGER:-logger}
	SERVICE=${ZORO_SERVICE:-/etc/init.d/zoro-xray}
	PROBE_URL=${ZORO_PROBE_URL:-https://www.gstatic.com/generate_204}
	PROBE_TIMEOUT=${ZORO_PROBE_TIMEOUT:-8}
	SOCKS_PORT=${ZORO_SOCKS_PORT:-7890}
	DNSPY=${ZORO_DNSPY:-python3}
	STATE_FILE=${ZORO_STATE_FILE:-/etc/zoro-exit.requested}
	LOCK_FILE=${ZORO_LOCK_FILE:-/var/lock/zoro-exit.lock}
	CONFIG=${ZORO_CONFIG:-/etc/zoro-n100-primary.json}
else
	NFT=/usr/sbin/nft
	IP=/sbin/ip
	SS=/usr/sbin/ss
	CURL=/usr/bin/curl
	LOGGER=/usr/bin/logger
	SERVICE=/etc/init.d/zoro-xray
	PROBE_URL=https://www.gstatic.com/generate_204
	PROBE_TIMEOUT=8
	SOCKS_PORT=7890
	DNSPY=/usr/bin/python3
	STATE_FILE=/etc/zoro-exit.requested
	LOCK_FILE=/var/lock/zoro-exit.lock
	CONFIG=/etc/zoro-n100-primary.json
fi

COMMENT="zoro-exit"
MARK="0x00000002"
TABLE=101
PREF=1000
PORT=7895

log() {
	"$LOGGER" -t zoro-exit -- "$*" >/dev/null 2>&1 || true
	printf '%s\n' "$*" >&2
}

die() {
	log "ERROR: $*"
	exit 1
}

usage() {
	printf 'usage: %s {on [--force] [--repair]|off [--force]|status}\n       %s check\n' "$0" "$0" >&2
	exit 2
}

rule_lines() {
	"$NFT" -a list chain inet sw_lan_tproxy prerouting 2>/dev/null \
		| grep -F "comment \"$COMMENT\""
}

rule_handles() {
	rule_lines | sed -n 's/.*# handle \([0-9][0-9]*\).*/\1/p'
}

chain_rules() {
	# $1 table, $2 chain -> lines tagged with our comment
	"$NFT" -a list chain inet "$1" "$2" 2>/dev/null \
		| grep -F "comment \"$COMMENT\""
}

chain_handles() {
	sed -n 's/.*# handle \([0-9][0-9]*\).*/\1/p'
}

dns_prerouting_lines() {
	chain_rules surflare prerouting
}

dns_output_lines() {
	chain_rules surflare output
}

ks_output_lines() {
	chain_rules killswitch output
}

dns_preempt_lines() {
	# Read a chain dump on stdin and print the rules that can take DNS traffic
	# before ours sees it.  Two shapes matter: anything matching port 53 in any
	# spelling, and any rule that sets a mark -- the chain ends with
	# `meta l4proto { tcp, udp } meta mark set 0x1 accept`, which matches every
	# DNS packet, so appending behind it leaves our rules dead while every
	# presence check still passes.  A rule scoped to a destination or an
	# interface cannot preempt traffic to anywhere else: those are the
	# watchdog's deliberate exemptions, and stepping in front of one cancels it.
	# A mark rule only matters when it constrains nothing else: the tail of the
	# chain marks every tcp/udp packet and accepts it.  A rule that marks one
	# other port cannot take DNS traffic, so it is neither a competitor nor an
	# anchor.
	awk -v c="comment \"$COMMENT\"" '
		index($0, c) { next }
		/ip6? daddr |oifname |oif "/ { next }
		/dport 53([^0-9]|$)|dport \{ 53[,}]/ { print; next }
		/meta mark set/ && !/dport/ { print; next }
	'
}

dns_output_anchor() {
	# Insert in front of the first rule that could preempt us.  Reader and
	# writer share one predicate on purpose: a reader that counts a rule the
	# writer cannot anchor on asks for an order the writer can never produce.
	# Our own rules are excluded -- the rebuild deletes them first, and an
	# insert at the handle of a rule that no longer exists fails outright.
	"$NFT" -a list chain inet surflare output 2>/dev/null \
		| dns_preempt_lines \
		| head -1 \
		| sed -n 's/.*# handle \([0-9][0-9]*\).*/\1/p'
}

ks_output_anchor() {
	# Insert before the oif lo accept rule so the accept lands right
	# after ct state invalid drop (which must stay the chain's first
	# verdict) and ahead of every other rule.
	"$NFT" -a list chain inet killswitch output 2>/dev/null \
		| grep -F 'oif "lo" accept' \
		| head -1 \
		| sed -n 's/.*# handle \([0-9][0-9]*\).*/\1/p'
}

dns_rule_ok() {
	# Verify with the same five predicates the installer repairs with.  Reading
	# the chains a second way (first match per family) made the two disagree: a
	# stale copy ahead of a good one satisfied the repair test but failed the
	# old verification, and "on" then rolled back a switch that was working.
	dns_prerouting_ok udp || return 1
	dns_prerouting_ok tcp || return 1
	dns_output_ok udp || return 1
	dns_output_ok tcp || return 1
	ks_output_ok || return 1
	return 0
}

dns_order_ok() {
	# Existence is not enough: a rule that sits behind a competing mark-0x1
	# rule never sees the traffic it was installed for.  Both halves used to be
	# read with head -1, which passed a pair where only one protocol was
	# shadowed, and the foreign rule was matched by literal adjacency, which
	# missed any rule carrying a counter or another qualifier.  Compare the last
	# Zoro line against the first foreign one, matched loosely.
	# shellcheck disable=SC3043  # OpenWrt ash supports local
	local _dump _last _first
	_dump=$("$NFT" -a list chain inet surflare output 2>/dev/null) || return 1
	# Our side counts only the rules that actually catch DNS: a comment on some
	# other rule says nothing about ordering.
	_last=$(printf '%s\n' "$_dump" \
		| grep -n -E 'dport 53([^0-9]|$)|dport \{ 53[,}]' \
		| grep -F "comment \"$COMMENT\"" | tail -1 | cut -d: -f1)
	# The competing side is exactly what the installer has to step in front of,
	# so both read the same list and cannot disagree.
	_first=$(printf '%s\n' "$_dump" | grep -n '' | dns_preempt_lines | head -1 | cut -d: -f1)
	[ -n "$_last" ] || return 1
	# No foreign dport-53 mark rule at all means nothing can shadow us.
	[ -z "$_first" ] || [ "$_last" -lt "$_first" ]
}

dns_state() {
	# ok | missing | misplaced
	dns_rule_ok || { printf 'missing'; return 0; }
	dns_order_ok || { printf 'misplaced'; return 0; }
	printf 'ok'
}

dns_prerouting_ok() {
	# $1 = l4proto; the catch is only useful together with the mark set on the
	# same rule, so both halves are required.
	chain_rules surflare prerouting \
		| grep -F "meta l4proto $1 meta mark $MARK" \
		| grep -Fq "tproxy ip to :$PORT meta mark set $MARK"
}

dns_output_ok() {
	# $1 = udp|tcp.  The trailing space keeps udp dport 5353 from satisfying a
	# check that asks for dport 53, and the mark is required on the same rule.
	chain_rules surflare output \
		| grep -F "$1 dport 53 " \
		| grep -Fq "meta mark set $MARK"
}

ks_output_ok() {
	ks_output_lines | grep -Fq "meta mark $MARK accept"
}

ensure_dns_rules() {
	# shellcheck disable=SC3043  # OpenWrt ash supports local
	# Each of the five DNS-consistency rules is repaired on its own.  A group
	# that is half present -- one of a udp/tcp pair lost, or an interrupted
	# install -- used to be skipped as done, which left "on" failing until
	# someone ran "off" first.
	local _anchor _h
	dns_prerouting_ok udp || {
		"$NFT" insert rule inet surflare prerouting \
			meta nfproto ipv4 meta l4proto udp meta mark "$MARK" \
			tproxy ip to ":$PORT" meta mark set "$MARK" \
			accept comment "$COMMENT" 2>/dev/null || return 1
	}
	dns_prerouting_ok tcp || {
		"$NFT" insert rule inet surflare prerouting \
			meta nfproto ipv4 meta l4proto tcp meta mark "$MARK" \
			tproxy ip to ":$PORT" meta mark set "$MARK" \
			accept comment "$COMMENT" 2>/dev/null || return 1
	}
	if ! dns_output_ok udp || ! dns_output_ok tcp || ! dns_order_ok; then
		# Rebuild the pair in front of whatever competes.  The deletes come
		# first and the anchor is read afterwards: an anchor read before the
		# deletes can name one of our own rules, and nft rejects an insert at a
		# handle that no longer exists.
		for _h in $(dns_output_lines | chain_handles); do
			"$NFT" delete rule inet surflare output handle "$_h" 2>/dev/null || true
		done
		_anchor=$(dns_output_anchor)
		if [ -n "$_anchor" ]; then
			"$NFT" insert rule inet surflare output position "$_anchor" \
				meta nfproto ipv4 udp dport 53 meta mark set "$MARK" \
				accept comment "$COMMENT" 2>/dev/null || return 1
			"$NFT" insert rule inet surflare output position "$_anchor" \
				meta nfproto ipv4 tcp dport 53 meta mark set "$MARK" \
				accept comment "$COMMENT" 2>/dev/null || return 1
		else
			"$NFT" add rule inet surflare output \
				meta nfproto ipv4 udp dport 53 meta mark set "$MARK" \
				accept comment "$COMMENT" 2>/dev/null || return 1
			"$NFT" add rule inet surflare output \
				meta nfproto ipv4 tcp dport 53 meta mark set "$MARK" \
				accept comment "$COMMENT" 2>/dev/null || return 1
		fi
	fi
	if ! ks_output_ok; then
		_anchor=$(ks_output_anchor)
		[ -n "$_anchor" ] || return 1
		"$NFT" insert rule inet killswitch output position "$_anchor" \
			meta mark "$MARK" accept comment "$COMMENT" 2>/dev/null || return 1
	fi
	# Success means the same thing "check" means: all five rules present and
	# in front of the rules they have to preempt.
	dns_rule_ok || return 1
	dns_order_ok
}

drop_dns_rules() {
	# shellcheck disable=SC3043  # OpenWrt ash supports local
	local _t _c _h _t_c
	for _t_c in "surflare prerouting" "surflare output" "killswitch output"; do
		# shellcheck disable=SC2086
		set -- $_t_c
		_t=$1; _c=$2
		# shellcheck disable=SC2086
		for _h in $(chain_rules "$_t" "$_c" | chain_handles); do
			"$NFT" delete rule inet "$_t" "$_c" handle "$_h" 2>/dev/null || true
		done
	done
}

surflare_handle() {
	"$NFT" -a list chain inet sw_lan_tproxy prerouting 2>/dev/null \
		| grep -F "tproxy ip to :10800" \
		| sed -n 's/.*# handle \([0-9][0-9]*\).*/\1/p' \
		| head -1
}

tombstone_handle() {
	"$NFT" -a list chain inet sw_lan_tproxy prerouting 2>/dev/null \
		| grep -E 'iifname "br-lan".*meta l4proto tcp reject' \
		| sed -n 's/.*# handle \([0-9][0-9]*\).*/\1/p' \
		| head -1
}

order_before_tombstone() {
	# shellcheck disable=SC3043  # OpenWrt ash supports local
	local _dump _z _t
	_dump=$("$NFT" -a list chain inet sw_lan_tproxy prerouting 2>/dev/null) || return 1
	_z=$(printf '%s\n' "$_dump" | grep -n -F "comment \"$COMMENT\"" | head -1 | cut -d: -f1)
	_t=$(printf '%s\n' "$_dump" | grep -n -E 'iifname "br-lan".*meta l4proto tcp reject' | head -1 | cut -d: -f1)
	[ -n "$_z" ] && [ -n "$_t" ] && [ "$_z" -lt "$_t" ]
}

nft_ready() {
	"$NFT" list table inet sw_lan_tproxy >/dev/null 2>&1
}

chain_ready() {
	"$NFT" list chain inet sw_lan_tproxy prerouting >/dev/null 2>&1
}

route_ok() {
	"$IP" rule 2>/dev/null | grep -Eq "fwmark 0x0*2 lookup ${TABLE}( |$)" &&
		"$IP" route show table "$TABLE" 2>/dev/null | grep -Fq 'local default'
}

order_ok() {
	# nft handles are a monotonic counter, so insert-before gets a HIGHER
	# handle. Compare line numbers in one chain dump, which follow eval order.
	# shellcheck disable=SC3043  # OpenWrt ash supports local
	local _dump _z _s
	_dump=$("$NFT" -a list chain inet sw_lan_tproxy prerouting 2>/dev/null) || return 1
	_z=$(printf '%s\n' "$_dump" | grep -n -F "comment \"$COMMENT\"" | head -1 | cut -d: -f1)
	_s=$(printf '%s\n' "$_dump" | grep -n -F "tproxy ip to :10800" | head -1 | cut -d: -f1)
	[ -n "$_z" ] && [ -n "$_s" ] && [ "$_z" -eq "$((_s - 1))" ]
}

rule_ok() {
	# shellcheck disable=SC3043  # OpenWrt ash supports local
	local _line
	_line=$(rule_lines | head -1)
	[ -n "$_line" ] || return 1
	printf '%s\n' "$_line" | grep -F "tproxy ip to :$PORT" >/dev/null || return 1
	printf '%s\n' "$_line" | grep -F "meta mark set $MARK" >/dev/null || return 1
	printf '%s\n' "$_line" | grep -F 'ct mark set 0x00000200' >/dev/null || return 1
	printf '%s\n' "$_line" | grep -F 'iifname "br-lan"' >/dev/null || return 1
	printf '%s\n' "$_line" | grep -F 'meta nfproto ipv4' >/dev/null || return 1
	printf '%s\n' "$_line" | grep -F ' accept' >/dev/null || return 1
	printf '%s\n' "$_line" | grep -F 'l4proto tcp' >/dev/null || return 1
	return 0
}

add_route() {
	"$IP" rule add fwmark "$MARK" lookup "$TABLE" pref "$PREF" 2>/dev/null || true
	"$IP" route add local 0.0.0.0/0 dev lo table "$TABLE" 2>/dev/null || true
}

del_route() {
	"$IP" rule del fwmark "$MARK" lookup "$TABLE" pref "$PREF" 2>/dev/null || true
	"$IP" route del local 0.0.0.0/0 dev lo table "$TABLE" 2>/dev/null || true
}

xray_up() {
	"$SS" -ltn 2>/dev/null | grep -Eq "(\*|0\.0\.0\.0|\[::\]):${PORT}[[:space:]]"
}

ensure_xray() {
	xray_up && return 0
	# The lock fd stays open for this whole run, and a service that backgrounds
	# its daemon would inherit it and hold the lock after we exit.
	"$SERVICE" start >/dev/null 2>&1 9>&- || true
	for _ in 1 2 3 4 5; do
		sleep 1
		xray_up && return 0
	done
	return 1
}

requested_state() {
	if [ ! -e "$STATE_FILE" ]; then
		echo unset
	elif [ ! -s "$STATE_FILE" ]; then
		echo unknown
	else
		# Normalize CR/spaces, but never guess an unrecognized value.
		case "$(tr -d ' \r' < "$STATE_FILE")" in
		on) echo on ;;
		off) echo off ;;
		*) echo unknown ;;
		esac
	fi
}

report_unknown() {
	printf 'mode=unknown\nnft=unreadable\nprobe_scope=socks\n'
	printf 'route=unknown\nxray_listening=%s\n' "$(xray_up && echo yes || echo no)"
	printf 'fallback=unknown\norder=unknown\nprobe_http=skipped\nprobe=skipped\n'
}

probe_once() {
	# shellcheck disable=SC3043  # OpenWrt ash supports local
	local _code
	_code=$("$CURL" -sS --max-time "$PROBE_TIMEOUT" \
		--socks5-hostname "127.0.0.1:$SOCKS_PORT" \
		-o /dev/null -w '%{http_code}' -- "$PROBE_URL" 2>/dev/null) || _code=000
	_probe_code=$_code
	case "$_code" in
	200|204) return 0 ;;
	*) return 1 ;;
	esac
}

# The watchdog restores the switch on its own while a person may be running the
# same command from a shell.  Without a lock the two interleave: one deletes the
# rules the other just added, and the recorded state no longer describes nft.
# flock rather than a lock directory: the kernel owns the lock, so a killed run
# cannot leave it behind, nothing has to trust a pid or a timestamp, and a
# recycled pid cannot wedge the switch.  The watchdog already depends on flock.
LOCK_BUSY=4
LOCK_FD=9

acquire_lock() {
	# shellcheck disable=SC3043  # OpenWrt ash supports local
	local _tries=0
	# A failed redirection on exec is fatal in bash and ash alike, so the path is
	# probed with a plain append first and the failure reported in our own words.
	# Redirections are processed left to right, so the suppressor comes first:
	# with the append first, the shell prints its own error before the stderr
	# redirect takes effect.  `true` rather than `:`: a redirection failure on a
	# special builtin ends the shell outright, before the message is printed.
	command -v flock >/dev/null 2>&1 ||
		die "flock is required to serialise the switch; it is missing from PATH"
	if ! true 2>/dev/null >>"$LOCK_FILE"; then
		die "cannot open the lock file $LOCK_FILE"
	fi
	exec 9>>"$LOCK_FILE"
	while ! flock -n "$LOCK_FD"; do
		_tries=$((_tries + 1))
		if [ "$_tries" -ge 5 ]; then
			log "ERROR: another zoro-exit is running; try again shortly"
			exit "$LOCK_BUSY"
		fi
		# Whole seconds: busybox without fancy sleep rejects 0.25.
		sleep 1
	done
	# The lock is released when this process exits, however it exits.  These
	# handlers exist so a signal actually ends the run instead of letting the
	# handler return and the work continue.
	trap 'exit 130' INT
	trap 'exit 143' TERM
	trap 'exit 129' HUP
}

do_on() {
	_force=0
	_repair=0
	while [ $# -gt 0 ]; do
		case "$1" in
		--force) _force=1 ;;
		--repair) _repair=1 ;;
		*) usage ;;
		esac
		shift
	done
	acquire_lock
	# Repair mode restores a switch that is still asked for; it never overrides
	# an intent.  The request file is read under the lock so a person's "off"
	# that finished while this run was queued wins instead of being reverted.
	if [ "$_repair" -eq 1 ] && [ "$(requested_state)" = off ]; then
		log "on: repair skipped, a switch-off was requested"
		return 0
	fi
	nft_ready && chain_ready || die "sw_lan_tproxy is not readable"
	sh=$(surflare_handle)
	_anchor=$sh
	if [ -z "$sh" ] && [ "$_force" -eq 0 ]; then
		die "Surflare tproxy :10800 rule missing; use 'on --force' to switch anyway"
	fi
	if [ -z "$_anchor" ]; then
		_anchor=$(tombstone_handle)
	fi
	[ -x "$SERVICE" ] || die "xray service missing: $SERVICE"
	[ -r "$CONFIG" ] || die "xray config missing: $CONFIG"
	ensure_xray || die "xray tproxy $PORT is not listening"
	probe_once || die "Zoro uplink probe failed (HTTP $_probe_code); not switching"
	add_route
	route_ok || {
		del_route
		die "failed to install fwmark $MARK route"
	}

	# A stale or foreign rule is removed and replaced, not treated as success.
	_had_rule=0
	[ -n "$(rule_handles)" ] && _had_rule=1
	if [ -n "$(rule_handles)" ] && { ! order_ok || ! rule_ok; }; then
		for h in $(rule_handles); do
			"$NFT" delete rule inet sw_lan_tproxy prerouting handle "$h" 2>/dev/null || true
		done
	fi
	if [ -z "$(rule_handles)" ]; then
		if [ -n "$_anchor" ]; then
			"$NFT" insert rule inet sw_lan_tproxy prerouting position "$_anchor" \
				iifname "br-lan" meta nfproto ipv4 meta l4proto tcp \
				tproxy ip to ":$PORT" meta mark set "$MARK" \
				ct mark set 0x00000200 accept comment "$COMMENT" 2>/dev/null || {
					del_route
					die "failed to insert Zoro tproxy rule"
				}
		else
			# No :10800 anchor: append after every bypass return instead of
			# prepending above them.
			"$NFT" add rule inet sw_lan_tproxy prerouting \
				iifname "br-lan" meta nfproto ipv4 meta l4proto tcp \
				tproxy ip to ":$PORT" meta mark set "$MARK" \
				ct mark set 0x00000200 accept comment "$COMMENT" 2>/dev/null || {
					del_route
					die "failed to add Zoro tproxy rule"
				}
		fi
	fi

	if [ -n "$sh" ]; then
		order_ok && rule_ok || {
			for h in $(rule_handles); do
				"$NFT" delete rule inet sw_lan_tproxy prerouting handle "$h" 2>/dev/null || true
			done
			del_route
			die "Zoro rule is missing, misplaced, or does not match the configured port/mark"
		}
	elif [ -n "$_anchor" ]; then
		order_before_tombstone && rule_ok || {
			for h in $(rule_handles); do
				"$NFT" delete rule inet sw_lan_tproxy prerouting handle "$h" 2>/dev/null || true
			done
			del_route
			die "Zoro rule is behind the Surflare tombstone or does not match the port/mark"
		}
	else
		rule_ok || {
			for h in $(rule_handles); do
				"$NFT" delete rule inet sw_lan_tproxy prerouting handle "$h" 2>/dev/null || true
			done
			del_route
			die "Zoro rule does not match the configured port/mark"
		}
	fi

	ensure_dns_rules || {
		# These rules were already in place before this run, so a DNS-side
		# failure says nothing about them: removing them would turn a repair
		# attempt into an outage.  Leave the switch and report the failure.
		if [ "$_had_rule" -eq 0 ]; then
			for h in $(rule_handles); do
				"$NFT" delete rule inet sw_lan_tproxy prerouting handle "$h" 2>/dev/null || true
			done
			drop_dns_rules
			del_route
		fi
		die "failed to install the DNS exit rules"
	}

	if ! printf 'on\n' > "$STATE_FILE"; then
		if [ "$_had_rule" -eq 0 ]; then
			for h in $(rule_handles); do
				"$NFT" delete rule inet sw_lan_tproxy prerouting handle "$h" 2>/dev/null || true
			done
			drop_dns_rules
			del_route
		fi
		die "failed to record requested state"
	fi
	log "on: LAN TCP -> $PORT; router DNS -> $PORT; Surflare :10800 is configured but not automatic"
}

do_off() {
	_force=0
	if [ $# -gt 0 ]; then
		[ $# -eq 1 ] && [ "$1" = "--force" ] || usage
		_force=1
	fi
	acquire_lock
	if ! nft_ready || ! chain_ready; then
		die "sw_lan_tproxy is not readable; refusing to stop the service while the Zoro rule may remain"
	fi
	if [ -z "$(surflare_handle)" ] && [ "$_force" -eq 0 ]; then
		die "Surflare tproxy :10800 rule missing; remove the Zoro rule with 'off --force'"
	fi
	for h in $(rule_handles); do
		"$NFT" delete rule inet sw_lan_tproxy prerouting handle "$h" 2>/dev/null || true
	done
	drop_dns_rules
	[ -z "$(rule_handles)" ] || die "Zoro rule still present after off"
	[ -z "$(dns_prerouting_lines)" ] || die "Zoro DNS tproxy rules still present after off"
	[ -z "$(dns_output_lines)" ] || die "Zoro DNS mark rules still present after off"
	[ -z "$(ks_output_lines)" ] || die "Zoro killswitch accept still present after off"
	del_route
	if route_ok; then
		die "policy route still present after off"
	fi
	"$SERVICE" stop >/dev/null 2>&1 || true
	printf 'off\n' > "$STATE_FILE" || die "failed to record requested state"
	if [ -n "$(surflare_handle)" ]; then
		log "off: LAN TCP -> Surflare :10800"
	else
		log "off: Zoro rule removed; LAN TCP has no exit (Surflare :10800 is absent)"
	fi
}

# The SOCKS probe says nothing about the UDP tproxy :7895 path actually
# carrying DNS. Resolve a fixed name through a fixed foreign resolver; any
# well-formed DNS answer (even NXDOMAIN) proves the new exit path works
# end to end. python3 is already a watchdog dependency on this host.
probe_dns() {
	"$DNSPY" - <<'PYEOF' 2>/dev/null
import socket, struct, sys
def name(n):
    out = b""
    for part in n.split("."):
        out += bytes([len(part)]) + part.encode()
    return out + b"\0"
tid = 0x7A2B
query = struct.pack(">HHHHHH", tid, 0x0100, 1, 0, 0, 0) + name("cloudflare.com") + struct.pack(">HH", 1, 1)
try:
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(5)
    s.sendto(query, ("1.1.1.1", 53))
    data, _ = s.recvfrom(512)
    rid = struct.unpack(">H", data[:2])[0]
    sys.exit(0 if rid == tid else 1)
except Exception:
    sys.exit(1)
PYEOF
}

do_check() {
	[ $# -eq 0 ] || usage
	if ! nft_ready || ! chain_ready; then
		report_unknown
		return 3
	fi

	if [ -z "$(rule_handles)" ]; then
		_req=$(requested_state)
		if [ "$_req" = unknown ]; then
			printf 'mode=unknown\nnft=ok\nprobe_scope=socks\nroute=unknown\nxray_listening=%s\n' "$(xray_up && echo yes || echo no)"
			printf 'fallback=unknown\norder=unknown\nprobe_http=skipped\nprobe=skipped\n'
			return 3
		fi
		if [ "$_req" = on ]; then
			printf 'mode=lost\nnft=ok\nprobe_scope=socks\n'
			printf 'route=%s\n' "$(route_ok && echo ok || echo missing)"
			printf 'xray_listening=%s\n' "$(xray_up && echo yes || echo no)"
			printf 'fallback=%s\n' "$( [ -n "$(surflare_handle)" ] && echo ok || echo missing)"
			printf 'order=missing\n'
			# The data rule is gone: the DNS rules are what an operator needs to
			# know about next, and they can survive on their own.
			printf 'dns=%s\n' "$(dns_state)"
			printf 'probe_http=skipped\nprobe=skipped\n'
			return 1
		fi
		printf 'mode=off\nnft=ok\nprobe_scope=socks\n'
		printf 'route=%s\n' "$(route_ok && echo ok || echo missing)"
		printf 'xray_listening=%s\n' "$(xray_up && echo yes || echo no)"
		printf 'fallback=%s\n' "$( [ -n "$(surflare_handle)" ] && echo ok || echo missing)"
		printf 'order=missing\n'
		# A deliberate off that left our DNS rules behind is not healthy:
		# "off" verifies the same thing and refuses to call it done.
		if [ -n "$(dns_prerouting_lines)$(dns_output_lines)$(ks_output_lines)" ]; then
			printf 'dns=residue\nprobe_http=skipped\nprobe=fail\n'
			return 1
		fi
		printf 'probe_http=skipped\nprobe=skipped\n'
		return 0
	fi

	_fb=missing
	[ -n "$(surflare_handle)" ] && _fb=ok
	_order=missing
	if [ "$_fb" = ok ]; then
		order_ok && rule_ok && _order=ok || _order=misplaced
	elif [ -n "$(tombstone_handle)" ]; then
		order_before_tombstone && rule_ok && _order=ok || _order=misplaced
	else
		_order=unverified
	fi
	printf 'mode=on\nnft=ok\nprobe_scope=socks\n'
	printf 'route=%s\n' "$(route_ok && echo ok || echo missing)"
	printf 'xray_listening=%s\n' "$(xray_up && echo yes || echo no)"
	printf 'fallback=%s\n' "$_fb"
	printf 'order=%s\n' "$_order"
	_dns=$(dns_state)
	printf 'dns=%s\n' "$_dns"

	if [ "$_dns" != ok ]; then
		printf 'probe_http=skipped\nprobe=fail\n'
		return 1
	fi
	if ! route_ok; then
		printf 'probe_http=skipped\nprobe=fail\n'
		return 1
	fi
	if ! xray_up; then
		printf 'probe_http=skipped\nprobe=fail\n'
		return 1
	fi
	if [ "$_order" != ok ] && [ "$_order" != unverified ]; then
		printf 'probe_http=skipped\nprobe=fail\n'
		return 1
	fi
	if ! probe_once; then
		printf 'probe_http=%s\nprobe=fail\n' "$_probe_code"
		return 1
	fi
	if ! probe_dns; then
		printf 'probe_http=%s\nprobe=fail\n' "$_probe_code"
		return 1
	fi
	printf 'probe_http=%s\nprobe=ok\n' "$_probe_code"
	return 0
}

do_status() {
	[ $# -eq 0 ] || usage
	if ! nft_ready || ! chain_ready; then
		printf 'mode=unknown\nnft=unreadable\nroute=unknown\nxray_listening=%s\nsurflare_10800=unknown\n' "$(xray_up && echo yes || echo no)"
		return 3
	fi
	if [ -n "$(rule_handles)" ]; then
		mode=on
	else
		mode=off
		case "$(requested_state)" in
		on) mode=lost ;;
		unknown) mode=unknown ;;
		esac
	fi
	printf 'mode=%s\nnft=ok\n' "$mode"
	printf 'route=%s\n' "$(route_ok && echo ok || echo missing)"
	printf 'xray_listening=%s\n' "$(xray_up && echo yes || echo no)"
	printf 'surflare_10800=%s\n' "$( [ -n "$(surflare_handle)" ] && echo yes || echo no)"
	# Report the DNS dimension whenever the switch is meant to be up: with the
	# data rule lost is exactly when an operator wants to know whether the DNS
	# rules survived.  A deliberate off has none to report on.
	if [ "$mode" != off ]; then
		printf 'dns=%s\n' "$(dns_state)"
	fi
	case "$mode" in
	lost) return 1 ;;
	unknown) return 3 ;;
	esac
	return 0
}

cmd=${1:-status}
case "$cmd" in
on|off|check|status)
	[ $# -gt 0 ] && shift
	;;
*) usage ;;
esac
case "$cmd" in
on) do_on "$@" ;;
off) do_off "$@" ;;
check) do_check "$@" ;;
status) do_status "$@" ;;
esac
