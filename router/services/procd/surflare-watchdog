#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

SCRIPT=/usr/local/sbin/surflare_watchdog.sh

start_service() {
    procd_open_instance
    procd_set_param command "$SCRIPT"
    # respawn <threshold> <timeout> <retry>
    # threshold=3600: crashes within 1h count toward retry limit
    # timeout=5: wait 5s between restarts
    # retry=0: NEVER give up restarting (prevents orphan killswitch)
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

restart() {
    # Sentinel: tell stop_service this is a restart, not a full stop.
    # cleanup() in the watchdog handles modular teardown on SIGTERM
    # (killswitch persists, tproxy tombstoned), so stop_service skips
    # full teardown during restart.
    touch /run/surflare_restarting
    stop "$@"
    start "$@"
    rm -f /run/surflare_restarting
}

stop_service() {
    if [ -f /run/surflare_restarting ]; then
        # Restart: cleanup() trap already did modular teardown.
        # Killswitch persists so CN traffic keeps flowing.
        return 0
    fi

    # Explicit stop: full teardown to prevent self-lock (killswitch
    # output policy=drop with no running watchdog = total network loss).
    _full_teardown
    if nft list table inet killswitch >/dev/null 2>&1; then
        logger -t surflare-watchdog "WARN: service stopped but killswitch persists"
    else
        logger -t surflare-watchdog "Service stopped: all nft tables removed"
    fi
}

# Shared teardown logic for stop_service and the dead-man's switch cron.
_full_teardown() {
    nft delete table inet killswitch 2>/dev/null
    nft delete table ip sw_lan_tproxy 2>/dev/null
    nft delete table ip dns_enforce 2>/dev/null
    nft delete table inet surflare 2>/dev/null
    nft delete table inet surflare_moat 2>/dev/null
    ip rule del fwmark 0x1 lookup 100 2>/dev/null
    rm -f /run/surflare_watchdog.killswitch_ready
    rm -f /run/surflare_watchdog.storm_cool_until
}

# Dead-man's switch: remove orphan killswitch if watchdog is not running.
# Called via cron every minute.  Prevents self-lock when procd cannot
# restart the watchdog (binary missing, disk full, OOM continuous).
extra_command "deadman" "Remove orphan killswitch if watchdog is dead"
deadman() {
    # Skip during restart: sentinel exists between stop and start.
    # Guard: if sentinel is older than 120s, the restart must have failed
    # (normal restart takes <10s).  Stale sentinel + dead watchdog = self-lock.
    if [ -f /run/surflare_restarting ]; then
        local age=$(( $(date +%s) - $(stat -c %Y /run/surflare_restarting 2>/dev/null || echo 0) ))
        if [ "$age" -lt 120 ]; then
            return 0
        fi
        rm -f /run/surflare_restarting
        logger -t surflare-deadman "Stale restart sentinel removed (age=${age}s)"
    fi
    # Check PID file first (fast), fall back to pgrep
    local pid
    pid=$(cat /var/run/surflare_watchdog.pid 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        return 0  # alive
    fi
    # PID stale or missing -- double-check with pgrep
    if pgrep -f surflare_watchdog.sh >/dev/null 2>&1; then
        return 0  # alive (PID file was stale)
    fi
    # Watchdog is dead.  Only act if killswitch is actually orphaned.
    if nft list table inet killswitch >/dev/null 2>&1; then
        _full_teardown
        if nft list table inet killswitch >/dev/null 2>&1; then
            logger -t surflare-deadman "WARN: teardown attempted but killswitch persists"
        else
            logger -t surflare-deadman "Orphan killswitch removed (watchdog not running)"
        fi
    fi
}
