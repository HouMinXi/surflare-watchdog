#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034  # USE_PROCD/START/STOP consumed by rc.common
# shellcheck disable=SC3043  # local is supported by busybox ash
# shellcheck disable=SC2154  # initscript provided by /etc/rc.common

USE_PROCD=1
START=95
STOP=10

SCRIPT=/usr/local/sbin/surflare_watchdog.sh
RESTART_MARKER=/run/surflare_watchdog.restart

start_service() {
    procd_open_instance
    procd_set_param command "$SCRIPT"
    procd_set_param respawn 3600 5 10
    procd_set_param term_timeout 15
    # Raise fd limit for the watchdog script.  Note: on iStoreOS 24.10.7
    # (procd 2026.03.14) this parameter is silently ignored; the actual
    # fix for surflare-proxy is the ulimit in the wrapper script
    # (scripts/surflare-proxy-wrapper.sh).  Kept as forward-compat for
    # future OpenWrt versions that support procd limits.
    procd_set_param limits nofile="65535 65535"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

restart() {
    touch /run/surflare_restarting || {
        logger -t surflare-watchdog "WARN: failed to create restart marker"
        return 1
    }
    stop "$@"
    # wait for watchdog to fully exit before starting the new instance.
    # stop() calls procd_kill which synchronously tells procd to send
    # SIGTERM; the watchdog's cleanup() trap then runs modular teardown.
    # without this wait, start() may register the new instance before the
    # old process exits, leaving orphans that hold the lock file and block
    # the new watchdog -- procd reports "running" but old code executes.
    local _waited=0
    while [ $_waited -lt 20 ]; do
        pgrep -f "surflare_watchdog.sh$" >/dev/null 2>&1 || break
        sleep 1
        _waited=$((_waited + 1))
    done
    start "$@"
    rm -f /run/surflare_restarting
}

# Override rc.common's stop(): call stop_service for cleanup, then
# procd_kill to notify procd.  procd_kill may fail ("Not found") when
# procd has no instance record (manual start, crash recovery, stale
# state); the error is silenced since stop_service already handled
# cleanup in that case.
stop() {
    stop_service
    procd_kill "$(basename "$(readlink "$initscript")")" "$1" 2>/dev/null || true
}

stop_service() {
    if [ -f /run/surflare_restarting ]; then
        # Restart: signal watchdog to do modular teardown (keep killswitch).
        # Marker must exist BEFORE procd sends SIGTERM so cleanup() sees it.
        touch "$RESTART_MARKER"
    fi
    # Do NOT manually kill the watchdog process here.  procd owns the
    # process lifecycle: it sends SIGTERM (triggering the watchdog's
    # cleanup() trap) and waits up to term_timeout (15s) before SIGKILL.
    # Manual kill races with procd: procd sees the process vanish before
    # its own SIGTERM and treats it as a crash -> respawn.
    #
    # Explicit stop: disconnect surflare + full teardown.
    # These run BEFORE procd kills the watchdog, so VPN and nftables are
    # cleaned up while the watchdog is still alive (it will exit via
    # procd's SIGTERM shortly after).
    if [ ! -f /run/surflare_restarting ]; then
        # Stop VPN tunnel and proxy.  Disconnect first (may involve
        # network, needs timeout) so surflare can clean up server-side
        # state.  Tear down nftables immediately after disconnect --
        # the killswitch only needs to stay active during the disconnect
        # API call, which has now completed.
        timeout 8 surflare disconnect >/dev/null 2>&1 || true
        _full_teardown
        killall surflare-proxy 2>/dev/null || true
        killall sexpect 2>/dev/null || true
        killall -9 surflare 2>/dev/null || true
        killall surflare_route_updater.sh 2>/dev/null || true
        # Kill orphan watchdog processes (PPid=1) accumulated from prior
        # restart cycles.  Exclude the PIDFILE PID: that is the procd-managed
        # watchdog, which procd will SIGTERM itself after stop_service returns.
        # Killing it here would race with procd and cause spurious respawn.
        local _main_pid _opid _op_ppid
        _main_pid=$(cat /run/surflare_watchdog.pid 2>/dev/null)
        for _opid in $(pgrep -f surflare_watchdog.sh 2>/dev/null); do
            [ "$_opid" = "$$" ] && continue
            [ "$_opid" = "$_main_pid" ] && continue
            _op_ppid=$(cat /proc/"$_opid"/status 2>/dev/null | awk "/^PPid/{print \$2}")
            if [ "$_op_ppid" = "1" ]; then
                logger -t surflare-watchdog "Stop: killing orphan watchdog (PID $_opid)"
                kill -TERM "$_opid" 2>/dev/null
            fi
        done
        sleep 1
        for _opid in $(pgrep -f surflare_watchdog.sh 2>/dev/null); do
            [ "$_opid" = "$$" ] && continue
            [ "$_opid" = "$_main_pid" ] && continue
            _op_ppid=$(cat /proc/"$_opid"/status 2>/dev/null | awk "/^PPid/{print \$2}")
            [ "$_op_ppid" = "1" ] && kill -9 "$_opid" 2>/dev/null
        done
        rm -f "$RESTART_MARKER"
    fi
    rm -f /run/surflare_watchdog.pid
    if [ -f /run/surflare_restarting ]; then
        logger -t surflare-watchdog "Service stopped for restart (killswitch preserved)"
    else
        logger -t surflare-watchdog "Service stopped: all nft tables removed"
    fi
}

# DUPLICATE: also defined in surflare_watchdog.sh _full_teardown(). Sync changes.
_full_teardown() {
    nft delete table inet killswitch 2>/dev/null
    nft delete table inet sw_lan_tproxy 2>/dev/null
    nft delete table ip dns_enforce 2>/dev/null
    nft delete table inet surflare 2>/dev/null
    nft delete table inet surflare_moat 2>/dev/null
    ip rule del fwmark 0x1 lookup 100 2>/dev/null
    ip -6 rule del fwmark 0x1 lookup 100 2>/dev/null
    rm -f /run/surflare_watchdog.killswitch_ready
    rm -f /run/surflare_watchdog.storm_cool_until
}

extra_command "deadman" "Remove orphan killswitch if watchdog is dead"
deadman() {
    local pid
    pid=$(cat /run/surflare_watchdog.pid 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        return 0
    fi
    if pgrep -f surflare_watchdog.sh >/dev/null 2>&1; then
        return 0
    fi
    if nft list table inet killswitch >/dev/null 2>&1; then
        _full_teardown
        logger -t surflare-deadman "Orphan killswitch removed (watchdog not running)"
    fi
}
