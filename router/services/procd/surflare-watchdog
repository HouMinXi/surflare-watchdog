#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=10

SCRIPT=/usr/local/sbin/surflare_watchdog.sh
RESTART_MARKER=/run/surflare_watchdog.restart

start_service() {
    # Self-heal: ensure deadman cron is installed
    crontab -l 2>/dev/null | grep -q 'surflare-watchdog deadman' ||         (crontab -l 2>/dev/null; echo "* * * * * /etc/init.d/surflare-watchdog deadman") | crontab -
    procd_open_instance
    procd_set_param command "$SCRIPT"
    procd_set_param respawn 3600 5 10
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

restart() {
    touch /run/surflare_restarting
    stop "$@"
    start "$@"
    rm -f /run/surflare_restarting
}

stop_service() {
    if [ -f /run/surflare_restarting ]; then
        # Restart: signal watchdog to do modular teardown (keep killswitch).
        # Marker must exist BEFORE SIGTERM so cleanup() sees it.
        touch "$RESTART_MARKER"
    fi
    local pid
    pid=$(cat /var/run/surflare_watchdog.pid 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        kill -TERM "$pid"
        local i=0
        while [ $i -lt 10 ] && kill -0 "$pid" 2>/dev/null; do
            sleep 1; i=$((i + 1))
        done
        kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
    fi
    # Explicit stop: full teardown if watchdog didn't clean up.
    if [ ! -f /run/surflare_restarting ]; then
        _full_teardown
        rm -f "$RESTART_MARKER"
    fi
    rm -f /var/run/surflare_watchdog.pid
    if [ -f /run/surflare_restarting ]; then
        logger -t surflare-watchdog "Service stopped for restart (killswitch preserved)"
    else
        logger -t surflare-watchdog "Service stopped: all nft tables removed"
    fi
}

_full_teardown() {
    nft delete table inet killswitch 2>/dev/null
    nft delete table inet sw_lan_tproxy 2>/dev/null
    nft delete table ip dns_enforce 2>/dev/null
    nft delete table inet surflare 2>/dev/null
    nft delete table inet surflare_moat 2>/dev/null
    ip rule del fwmark 0x1 lookup 100 2>/dev/null
    ip -6 rule del fwmark 0x1 lookup 100 2>/dev/null
    rm -f /run/surflare_watchdog.killswitch_ready
    rm -f /run/surflare_watchdog.storm_cool_until
}

extra_command "deadman" "Remove orphan killswitch if watchdog is dead"
deadman() {
    local pid
    pid=$(cat /var/run/surflare_watchdog.pid 2>/dev/null)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        return 0
    fi
    if pgrep -f surflare_watchdog.sh >/dev/null 2>&1; then
        return 0
    fi
    if nft list table inet killswitch >/dev/null 2>&1; then
        _full_teardown
        logger -t surflare-deadman "Orphan killswitch removed (watchdog not running)"
    fi
}
