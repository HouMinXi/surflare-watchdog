#!/bin/sh /etc/rc.common
# Keep the WAN receive spread asserted, and re-assert it right after anything
# that could have cleared it.
#
# The hotplug hook fires on interface add/register only.  On 2026-10-25 the
# value was found back at 0 with no reboot in between (uptime 6.9 days), so
# something clears it during normal operation and nothing was watching.  The
# cron entry that shipped with the assert script covers that within five
# minutes; this closes the window to seconds by riding the same ubus events
# packet_steering uses, delayed past its own 1 s debounce so ours runs second.
#
# Rollback: /etc/init.d/surflare_rps_assert disable && rm /etc/init.d/surflare_rps_assert
# shellcheck disable=SC2034  # /etc/rc.common reads START and USE_PROCD
START=99

# shellcheck disable=SC2034  # same: read by the procd loader
USE_PROCD=1

ASSERT=/usr/local/sbin/surflare_rps_assert.sh

start_service() {
	[ -x "$ASSERT" ] || return 0
	QUIET=1 "$ASSERT"
}

service_triggers() {
	procd_add_reload_trigger "network"
	procd_add_raw_trigger "interface.*" 3000 "$ASSERT"
}
