#!/bin/sh /etc/rc.common
USE_PROCD=1
START=62
STOP=10
PROG=/usr/sbin/smartdns
CONF=/etc/smartdns/custom.conf
start_service() {
    procd_open_instance
    procd_set_param command "$PROG" -c "$CONF" -p /tmp/smartdns.pid
    procd_set_param respawn 3600 5 0
    procd_set_param stderr 1
    procd_close_instance
}
