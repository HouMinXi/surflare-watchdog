# Files this repository installs on the router: <path in tree>:<path on box>:<mode>
# One list, three readers: the drift check compares checksums against it, the
# upgrade audit checks that sysupgrade keeps each one, and the reinstall tool
# copies each one with the mode written here.  install.sh writes the same
# destinations -- a path that appears in only one of the two is a box that
# cannot be rebuilt from this tree.
#
# /etc/surflare/ is deliberately absent: bypass-macs.conf in this tree
# holds placeholder MACs while a real box holds the household's, so
# installing it would replace working site config with examples.
surflare_watchdog.sh:/usr/local/sbin/surflare_watchdog.sh:755
surflare_l4_probe.sh:/usr/local/sbin/surflare_l4_probe.sh:755
surflare_log_health.sh:/usr/local/sbin/surflare_log_health.sh:755
surflare-update.sh:/usr/local/sbin/surflare-update.sh:755
cross_validate_routes.py:/usr/local/sbin/cross_validate_routes.py:755
cross_validate_cloud_cdn.py:/usr/local/sbin/cross_validate_cloud_cdn.py:755
setup_auth.sh:/usr/local/sbin/setup_auth.sh:755
laptop/surflare_early_detector.sh:/usr/local/sbin/surflare_early_detector.sh:755
laptop/surflare_node_probe.sh:/usr/local/sbin/surflare_node_probe.sh:755
router/services/procd/surflare-watchdog:/etc/init.d/surflare-watchdog:755
router/services/procd/surflare-rps-assert:/etc/init.d/surflare-rps-assert:755
router/surflare_route_updater.sh:/usr/local/sbin/surflare_route_updater.sh:755
router/ripe_fetch.py:/usr/local/sbin/ripe_fetch.py:755
router/@MODE@/surflare-lan-tproxy.nft:/etc/surflare-lan-tproxy.nft:644
scripts/surflare_rps_assert.sh:/usr/local/sbin/surflare_rps_assert.sh:755
router/services/surflare_rx_watch.sh:/usr/local/sbin/surflare_rx_watch.sh:755
router/hotplug/30-rps-wan-eth0:/etc/hotplug.d/net/30-rps-wan-eth0:755
router/sysctl/13-netdev-backlog.conf:/etc/sysctl.d/13-netdev-backlog.conf:644
etc/logrotate.d/surflare-watchdog:/etc/logrotate.d/surflare-watchdog:644
