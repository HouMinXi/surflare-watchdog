#!/sbin/openrc-run

description="Surflare Early TCP Degradation Detector"
command="/usr/local/sbin/surflare_early_detector.sh"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/surflare_detector.log"
error_log="/var/log/surflare_detector.log"

depend() {
    need surflare-watchdog
}
