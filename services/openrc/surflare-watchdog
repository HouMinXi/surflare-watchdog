#!/sbin/openrc-run

description="Surflare VPN Watchdog"
command="/usr/local/sbin/surflare_watchdog.sh"
command_background=true
pidfile="/run/${RC_SVCNAME}.pid"
output_log="/var/log/surflare_watchdog.log"
error_log="/var/log/surflare_watchdog.log"

depend() {
    need net
    after firewall
}

start_pre() {
    checkpath --directory /var/log
}
