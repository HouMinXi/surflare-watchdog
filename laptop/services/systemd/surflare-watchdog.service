[Unit]
Description=Surflare Watchdog Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/surflare_watchdog.sh
ExecStop=/bin/sh -c 'touch /run/surflare_watchdog.stopping; [ -n "$MAINPID" ] && /bin/kill -TERM $MAINPID || true'
TimeoutStopSec=15
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
