[Unit]
Description=Surflare Watchdog Daemon
After=network-online.target
Wants=network-online.target surflare-early-detector.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/surflare_watchdog.sh
ExecStop=/bin/sh -c '[ -n "$MAINPID" ] && /bin/kill -TERM $MAINPID || true'
TimeoutStopSec=30
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
